datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Leader {
  id               String   @id
  name             String
  role             String
  level            String   // 'distrital' | 'territorial' | 'seccional' | 'promotor' | 'promovido'
  levelIndex       Int      @default(0)
  parentId         String?
  parent           Leader?  @relation("LeaderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Leader[] @relation("LeaderHierarchy")
  territoryName    String
  code             String?
  phone            String?
  email            String?
  username         String?
  hasAccount       Boolean  @default(false)
  metaGoal         Int      @default(0)
  currentCount     Int      @default(0)
  status           String   @default("en_progreso") // 'completado' | 'en_progreso' | 'critico' | 'vacante'
  validationStatus String   @default("validado")   // 'validado' | 'pendiente' | 'rechazado'
  notes            String?  @db.Text
  avatarBg         String?  @default("bg-indigo-600")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([level])
  @@index([parentId])
  @@index([email])
}

model ElectoralSection {
  id              String             @id
  sectionNumber   String             @unique
  district        String
  municipality    String
  nominalList     Int                @default(0)
  geometry        Json?              // Coordenadas poligonales GeoJSON
  structures      SectionStructure[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model SectionStructure {
  id           String           @id
  sectionId    String
  section      ElectoralSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name         String
  leaderName   String
  targetCount  Int              @default(0)
  currentCount Int              @default(0)
  status       String           @default("en_progreso")
  rootLeaderId String?
  color        String?          @default("bg-sky-500")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([sectionId])
}

model UserAccount {
  id               String   @id
  email            String   @unique
  username         String
  name             String
  leaderId         String?
  level            String   // 'admin' | 'estatal' | 'distrital' | 'territorial' | 'seccional' | 'promotor'
  territoryName    String
  avatarBg         String?
  picture          String?
  isSuperAdmin     Boolean  @default(false)
  accountRoleLabel String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ElectoralSectionCatalog {
  id               String   @id @default(uuid())
  stateId          Int      @map("state_id")
  stateName        String   @map("state_name")
  federalDistrict  Int      @map("federal_district")
  districtHead     String?  @map("district_head")
  localDistrict    Int      @map("local_district")
  municipalityId   Int      @map("municipality_id")
  municipalityName String   @map("municipality_name")
  section          String   // Clave de 4 dígitos con cero ej. "0484"
  sectionType      String   @map("section_type") // URBANO(A), MIXTO(A), RURAL
  nominalMen       Int      @default(0) @map("nominal_men")
  nominalWomen     Int      @default(0) @map("nominal_women")
  nominalNonBinary Int      @default(0) @map("nominal_non_binary")
  nominalTotal     Int      @default(0) @map("nominal_total")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([stateId, section])
  @@index([stateId, municipalityId])
  @@index([stateId, federalDistrict])
  @@index([stateId, localDistrict])
  @@index([section])
  @@map("electoral_section_catalogs")
}

